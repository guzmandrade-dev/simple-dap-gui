{
  "name": "simple-dap-gui",
  "version": "0.5.0",
  "description": "A standalone DAP client GUI app using Electron + React + PrismJS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:icons": "node scripts/build-icons.js",
    "lint": "eslint src electron --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "electron",
    "react",
    "dap",
    "debugger",
    "prismjs",
    "xdebug"
  ],
  "author": {
    "name": "guzmandrade-dev",
    "email": "117118816+guzmandrade-dev@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@vscode/debugprotocol": "^1.68.0",
    "adm-zip": "^0.6.1",
    "fuzzysort": "^3.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "com.guzmandrade.simple-dap-gui",
    "productName": "simple-dap-gui",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "icon": "assets/icon.png",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz",
        "tar.xz"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "zip",
        "portable"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
